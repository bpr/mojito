#!/usr/bin/env bash
# The unattended Stage 6 acceptance run (run-stage6-acceptance.md items 1-3):
# pinned-runner benchmark baseline, full default + pliron gates, and the
# container compiler-free execution check, in that order, with per-step logs
# and a RESULTS.md summary under target/stage6-acceptance/<timestamp>/.
#
# Kick off while present (sudo password + docker pull need the first minute);
# everything after that is unattended. Steps are independent: a failure is
# recorded and the run continues. Exit status is nonzero if any required step
# failed. STAGE6_DRY_RUN=1 replaces the heavy steps with no-ops to test the
# orchestration plumbing.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

DRY_RUN="${STAGE6_DRY_RUN:-}"
LOG_ROOT="target/stage6-acceptance/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "${LOG_ROOT}"
RESULTS="${LOG_ROOT}/RESULTS.md"
RUNNER_ID="${RUNNER_ID:-$(hostname)}"
BUNDLE="dist/mojito-$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)-x86_64-unknown-linux-gnu"

# The baseline script needs sudo twice (~20 min apart) for the CPU governor;
# refresh the timestamp every minute so the unattended second call never
# prompts. The refresher dies with this script (trap) or when the cached
# credential lapses entirely.
if [[ -z "${DRY_RUN}" ]]; then
    echo "==> sudo credential for CPU-governor pinning (one prompt, then unattended)"
    sudo -v || { echo "sudo is required for the baseline's governor pinning"; exit 1; }
    ( while sudo -n true 2>/dev/null; do sleep 60; done ) &
    SUDO_KEEPALIVE=$!
    trap 'kill "${SUDO_KEEPALIVE}" 2>/dev/null' EXIT
fi

declare -a STEP_NAMES STEP_STATUSES STEP_SECONDS STEP_LOGS STEP_REQUIRED

# run_step <required|optional> <name> <command...>: tee output to a per-step
# log, record status and wall time, never abort the run.
run_step() {
    local required="$1" name="$2"
    shift 2
    local log="${LOG_ROOT}/${name}.log"
    local start end status
    echo "==> ${name} ($(date -u +%H:%M:%SZ)) [log: ${log}]"
    start=$(date +%s)
    if [[ -n "${DRY_RUN}" ]]; then
        { echo "[dry-run] $*"; true; } >"${log}" 2>&1
        status=$?
    else
        "$@" >"${log}" 2>&1
        status=$?
    fi
    end=$(date +%s)
    STEP_NAMES+=("${name}")
    STEP_STATUSES+=("${status}")
    STEP_SECONDS+=("$((end - start))")
    STEP_LOGS+=("${log}")
    STEP_REQUIRED+=("${required}")
    if [[ "${status}" -eq 0 ]]; then
        echo "    PASS (${name}, $((end - start))s)"
    else
        echo "    FAIL (${name}, exit ${status}; see ${log})"
    fi
    return 0
}

container_check() {
    local hello="/tmp/stage6-hello-$$"
    scripts/package-pliron || return 1
    "${BUNDLE}/bin/mojito" compile --backend pliron --emit exe -o "${hello}" \
        "${BUNDLE}/share/mojito/smoke/hello.mojo" || return 1
    local out
    out=$(docker run --rm -v "${hello}:/hello" ubuntu:24.04 /hello) || return 1
    rm -f "${hello}"
    echo "container stdout: ${out}"
    [[ "${out}" == *"mojito bundle ok"* ]]
}

# Optional prerequisite for the container step; pull now while the network is
# attended so the overnight portion has no network dependency.
run_step optional docker-pull docker pull ubuntu:24.04

# Baseline first: the machine is at its quietest and the sudo credential is
# freshest. Release tree only; the debug-tree gates follow.
run_step required bench-baseline env RUSTC_WRAPPER= scripts/run-bench-baseline.sh

# Default-features gate before the pliron gate: check-pliron rebuilds with the
# feature before any step that needs the pliron binary, so this order never
# leaves a featureless target/debug/mojito where a pliron step expects one.
run_step required check-default env RUSTC_WRAPPER= scripts/check
run_step required check-pliron env RUSTC_WRAPPER= scripts/check-pliron

run_step optional container-exec container_check

run_step required budget-report \
    scripts/stage6-budget-report "benchmarks/native/baseline/${RUNNER_ID}/summary.tsv"

# RESULTS.md: the morning entry point.
{
    echo "# Stage 6 acceptance run — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo
    echo "| step | required | status | duration | log |"
    echo "|---|---|---|---|---|"
    overall=0
    for i in "${!STEP_NAMES[@]}"; do
        if [[ "${STEP_STATUSES[$i]}" -eq 0 ]]; then
            verdict=PASS
        else
            verdict="FAIL(${STEP_STATUSES[$i]})"
            [[ "${STEP_REQUIRED[$i]}" == required ]] && overall=1
        fi
        echo "| ${STEP_NAMES[$i]} | ${STEP_REQUIRED[$i]} | ${verdict} | ${STEP_SECONDS[$i]}s | ${STEP_LOGS[$i]} |"
    done
    echo
    echo "## Morning follow-up"
    echo
    echo "- Triage any FAIL above from its log."
    echo "- Review ${LOG_ROOT}/budget-report.log against docs/notes/pliron-stage6-plan.md's budget table."
    echo "- Stage benchmarks/native/baseline/${RUNNER_ID}/{summary.tsv,raw.jsonl} for commit;"
    echo "  delete the *.run1.* agreement files (commit needs explicit approval)."
    echo "- On green: update docs/roadmap.md and docs/notes/pliron-stage6.md acceptance lists,"
    echo "  refresh commit_msg.txt, prune run-stage6-acceptance.md."
    exit "${overall}"
} | tee "${RESULTS}"
overall=${PIPESTATUS[0]}

echo
echo "==> done; summary at ${RESULTS}"
exit "${overall}"
