#!/usr/bin/env python3
"""Record the elaborator's instantiation counters over the whole corpus.

Usage: scripts/instantiation-report [--bin PATH] [--jobs N] [--out PATH]

Runs `BIN run --timings FILE` on every `assets/ok/*.mojo` and
`benchmarks/compile/*.mojo` fixture (only commands that elaborate report the
counters, so each fixture is executed, with stdin from /dev/null) and writes
one TSV row per fixture with the six `elaborate.*` size counters, then a
`total` row summing the elaborated fixtures. The committed baseline is
`benchmarks/instantiation.tsv`: a pass's effect on expansion is that file's
diff after a rerun. The file holds no date, hash, or binary path, so a rerun
on an unchanged tree diffs empty.

Without --bin the script runs `cargo build --quiet` first and uses
target/debug/mojito; with --bin it trusts the caller. MOJITO_STD_PACKAGE is
removed from the child environment, pinning the compiled std package.

Status column: `elaborated` when the counters were reported (whatever the
exit code: a runtime trap does not change the elaboration), `timeout` when
the child was killed, `failed` otherwise; failures are also listed on stderr
with their first diagnostic line. The exit status is 0 even with failed rows.
"""

import argparse
import concurrent.futures
import glob
import os
import re
import subprocess
import sys

COUNTERS = (
    "concrete_functions",
    "concrete_instructions",
    "generators",
    "generator_instances",
    "generator_instructions",
    "generator_instance_instructions",
)
COUNTER_PATH = re.compile(r"(?:^|\.)elaborate\.(" + "|".join(COUNTERS) + r")$")
INPUTS = ("assets/ok/*.mojo", "benchmarks/compile/*.mojo")
TIMEOUT_SECONDS = 120
SCRUBBED_ENV = ("MOJITO_STD_PACKAGE", "MOJITO_TIMING_NOTES")


def main():
    args = parse_args()
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    os.chdir(root)
    binary = args.bin or build_default()
    if not os.access(binary, os.X_OK):
        print(f"instantiation-report: no executable at {binary}", file=sys.stderr)
        return 2
    fixtures = sorted(path for pattern in INPUTS for path in glob.glob(pattern))
    env = {k: v for k, v in os.environ.items() if k not in SCRUBBED_ENV}
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        rows = list(pool.map(lambda f: measure(binary, f, env), fixtures))
    lines = ["\t".join(("fixture", "status") + COUNTERS)]
    lines += [format_row(row) for row in rows]
    lines.append(format_total(rows))
    text = "\n".join(lines) + "\n"
    if args.out == "-":
        sys.stdout.write(text)
    else:
        with open(args.out, "w", encoding="utf-8") as handle:
            handle.write(text)
    for fixture, status, _counts, cause in rows:
        if status != "elaborated":
            print(f"{status}: {fixture}: {cause}", file=sys.stderr)
    return 0


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--bin", help="mojito binary (default: build target/debug/mojito)")
    parser.add_argument("--jobs", type=int, default=8, help="parallel fixtures (default 8)")
    parser.add_argument(
        "--out",
        default="benchmarks/instantiation.tsv",
        help="output TSV, or - for stdout (default benchmarks/instantiation.tsv)",
    )
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error("--jobs must be at least 1")
    return args


def build_default():
    subprocess.run(["cargo", "build", "--quiet"], check=True)
    return "target/debug/mojito"


def measure(binary, fixture, env):
    try:
        result = subprocess.run(
            [binary, "run", "--timings", fixture],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            env=env,
            timeout=TIMEOUT_SECONDS,
            text=True,
            errors="replace",
        )
    except subprocess.TimeoutExpired:
        return (fixture, "timeout", None, f"killed after {TIMEOUT_SECONDS} s")
    counts = dict.fromkeys(COUNTERS, 0)
    reported = set()
    diagnostics = []
    for line in result.stderr.splitlines():
        fields = line.split("\t")
        if fields[0] == "count" and len(fields) == 3:
            match = COUNTER_PATH.search(fields[1])
            if match:
                counts[match.group(1)] += int(fields[2])
                reported.add(match.group(1))
        elif fields[0] not in ("count", "timing", "note") and line.strip():
            diagnostics.append(line.strip())
    if "concrete_instructions" in reported:
        return (fixture, "elaborated", counts, None)
    cause = diagnostics[0] if diagnostics else f"exit {result.returncode}"
    return (fixture, "failed", None, cause)


def format_row(row):
    fixture, status, counts, _cause = row
    values = [str(counts[c]) for c in COUNTERS] if counts else [""] * len(COUNTERS)
    return "\t".join([fixture, status] + values)


def format_total(rows):
    elaborated = [counts for _f, status, counts, _c in rows if status == "elaborated"]
    sums = [str(sum(counts[c] for counts in elaborated)) for c in COUNTERS]
    return "\t".join(["total", str(len(elaborated))] + sums)


if __name__ == "__main__":
    sys.exit(main())
