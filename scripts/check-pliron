#!/usr/bin/env bash
# Gate for the LLVM lane: the feature-gated Pliron backend inside mojito plus
# the Stage 0 spike. Deliberately kept out of scripts/check — the default VM
# lane must never require LLVM. Requires llvm-22-dev and clang; pins and CI
# recipe: docs/notes/pliron-stage0.md and docs/notes/pliron-stage1.md.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

export LLVM_SYS_221_PREFIX="${LLVM_SYS_221_PREFIX:-/usr/lib/llvm-22}"

echo "==> cargo build -p mojito-runtime (native runtime archive)"
cargo build -p mojito-runtime
export MOJITO_RUNTIME_LIB="${MOJITO_RUNTIME_LIB:-$PWD/target/debug/libmojito_runtime.a}"

echo "==> cargo fmt --check"
cargo fmt --check

echo "==> cargo clippy --features backend-pliron --all-targets -- -D warnings"
cargo clippy --features backend-pliron --all-targets -- -D warnings

echo "==> cargo nextest run --features backend-pliron (pliron tests)"
# --no-fail-fast: report every failure in one gate run. binary(pliron_*)
# catches every pliron integration target as slices add them.
cargo nextest run --no-fail-fast --features backend-pliron -E 'binary(pliron_*) + test(pliron)'

echo "==> bench smoke (machinery validation only; no performance claims)"
# Debug builds are fine here: the smoke lane validates the driver, the
# --timings channel, and the corpus, never performance. The pinned
# performance lane is scripts/bench-pliron.
(cd tools/bench && cargo build --quiet)
cargo build --quiet --features backend-pliron
tools/bench/target/debug/mojito-bench \
    --mojito target/debug/mojito --root benchmarks/native --smoke \
    --summary /dev/null

echo "==> pliron stage-0 spike gate"
scripts/check-pliron-spike
