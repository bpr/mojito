#!/usr/bin/env python3
"""Run the queued roadmap batches unattended, checking each before the next.

The batches are the `scripts/claude_loop.py` commands in
`docs/notes/next-batches.md`, in file order: each command is
one batch, its `--task`/`--only` IDs the batch's entries. An ID no longer on
the roadmap has landed and is dropped; a batch with none left is skipped.

Each batch runs:
  1. `scripts/claude_loop.py --model opus --plan-fable-on-opus --task ID ... -n 0`.
     A task the loop could not finish is noted and the run goes on (the
     loop already committed its work and skips what waits on it). A usage
     limit, an outage, or a failing environment stops the run.
  2. `scripts/focused`. Any failure stops the run.
  3. `scripts/instantiation-report --check`. A lost or failing fixture, or a
     growth over `--max-growth` percent, stops the run. Drift confined to
     `pointer_tuple_field_write.mojo` (R1069) passes. Any other growth or
     shrink is locked in: the fresh report becomes the baseline and is
     committed.

Every step's output goes to `target/run-batches/<stamp>/`, with a
`summary.md` of the run. The terminal shows the running step on one line,
updated in place with its latest output, and a line per finished step. On a stop the script prints what failed and the
command that resumes at that batch.

Usage:
  scripts/run-batches                 # run every batch with open entries
  scripts/run-batches --dry-run       # list the batches and their open entries
  scripts/run-batches --start 3       # resume at batch 3 (numbers from --dry-run)
  scripts/run-batches --max-growth 2  # tolerate up to 2% instruction growth
"""

from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
NOTE = ROOT / "docs/notes/next-batches.md"
BASELINE = ROOT / "benchmarks/instantiation.tsv"
FRESH = ROOT / "target/instantiation.tsv"
NOISY_FIXTURE = "assets/ok/pointer_tuple_field_write.mojo"
LOOP_STOPS = ("a usage limit stopped", "network outage", "sessions in a row failed")


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--dry-run", action="store_true", help="list the batches and exit")
    p.add_argument("--start", type=int, default=1, metavar="N", help="first batch to run")
    p.add_argument("--max-growth", type=float, default=1.0, metavar="PCT",
                   help="largest instruction growth locked in without stopping (default 1.0)")
    args = p.parse_args()
    os.chdir(ROOT)
    use_working_llvm()

    batches = [(number, open_ids(ids)) for number, ids in enumerate(note_batches(), 1)]
    if args.dry_run:
        for number, ids in batches:
            print(f"batch {number}: {' '.join(ids) if ids else '(all landed)'}")
        return 0

    log_dir = ROOT / "target/run-batches" / dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    log_dir.mkdir(parents=True, exist_ok=True)
    summary = Summary(log_dir / "summary.md")
    unfinished: list[str] = []
    # A batch run edits the note and the roadmap, so batch positions shift
    # mid-run: track the batches by the entries already attempted (or
    # skipped by `--start`), never by position.
    attempted = {i for _, ids in batches[: args.start - 1] for i in ids}
    while True:
        ids, number = next_batch(attempted)
        if not ids:
            break
        attempted.update(ids)
        summary.line(f"batch {number}: {' '.join(ids)}")

        loop = [sys.executable, "scripts/claude_loop.py", "--model", "opus",
                "--plan-fable-on-opus", *[a for i in ids for a in ("--task", i)], "-n", "0"]
        status, output = run(loop, log_dir / f"batch{number}-loop.log")
        if any(stop in output for stop in LOOP_STOPS):
            return summary.stop(number, "claude_loop stopped (usage limit, outage, or environment); "
                                f"see {log_dir}/batch{number}-loop.log", args)
        if status != 0:
            left = [i for i in ids if i in open_ids(ids)]
            unfinished += left
            summary.line(f"  claude_loop left unfinished: {' '.join(left) or '(see log)'}; continuing")

        status, _ = run(["scripts/focused"], log_dir / f"batch{number}-focused.log")
        if status != 0:
            return summary.stop(number, "scripts/focused failed; the report is "
                                "target/focused/last.log", args)
        summary.line("  focused: passed")

        _, output = run(["scripts/instantiation-report", "--check"],
                        log_dir / f"batch{number}-ratchet.log")
        verdict = ratchet_verdict(output, args.max_growth)
        if verdict.startswith("stop"):
            return summary.stop(number, f"instantiation ratchet: {verdict[5:]}; see "
                                f"{log_dir}/batch{number}-ratchet.log", args)
        if verdict == "refresh":
            BASELINE.write_bytes(FRESH.read_bytes())
            git("add", str(BASELINE.relative_to(ROOT)))
            git("commit", "-q", "-m", f"Refresh the instantiation baseline after batch {number} "
                f"({' '.join(ids)})")
            summary.line("  ratchet: baseline refreshed and committed")
        else:
            summary.line("  ratchet: passed")

    if unfinished:
        summary.line(f"done; unfinished entries to look at: {' '.join(unfinished)} "
                     "(target/claude-loop/*-unfinished.txt has the details)")
        return 1
    summary.line("done; every batch passed")
    return 0


def next_batch(attempted: set[str]) -> tuple[list[str], int]:
    """The first batch in the note, re-read now, with an open entry not yet
    attempted: those entries and the batch's current number, or `([], 0)`."""
    for number, ids in enumerate(note_batches(), 1):
        fresh = [i for i in open_ids(ids) if i not in attempted]
        if fresh:
            return fresh, number
    return [], 0


def note_batches() -> list[list[str]]:
    """The entry IDs of each `scripts/claude_loop.py` command in the note."""
    text = NOTE.read_text().replace("\\\n", " ")
    commands = re.findall(r"^\s*scripts/claude_loop\.py\b.*$", text, re.MULTILINE)
    return [re.findall(r"--(?:task|only)\s+(R\d+)", command) for command in commands]


def open_ids(ids: list[str]) -> list[str]:
    """The IDs of `ids` still on the roadmap, in order, without repeats."""
    listed = subprocess.run([sys.executable, "scripts/roadmap.py", "list"],
                            capture_output=True, text=True, check=True).stdout
    on_roadmap = set(re.findall(r"^\s*(R\d+)\b", listed, re.MULTILINE))
    return list(dict.fromkeys(i for i in ids if i in on_roadmap))


def ratchet_verdict(output: str, max_growth: float) -> str:
    """`pass`, `refresh`, or `stop <why>` for an instantiation `--check` report."""
    if "FAIL lost" in output or re.search(r"^failed:", output, re.MULTILINE):
        return "stop a fixture stopped elaborating"
    if "FAIL" not in output:
        return "pass"
    moved = re.findall(r"^\s+[+-]\d+\s+(\S+)$", output, re.MULTILINE)
    if moved and all(path == NOISY_FIXTURE for path in moved):
        return "pass"
    growth = re.search(r"FAIL growth: grew by \d+ instructions \(\+([\d.]+)%\)", output)
    if growth and float(growth.group(1)) > max_growth:
        return f"stop instructions grew {growth.group(1)}%, over --max-growth {max_growth}"
    if growth or "FAIL stale" in output:
        return "refresh"
    return "stop an unrecognized ratchet failure"


def run(command: list[str], log: Path) -> tuple[int, str]:
    """Run `command`, logging its output and showing its latest line in place."""
    label = Path(command[1] if command[0] == sys.executable else command[0]).name
    began = time.monotonic()
    chunks: list[str] = []
    latest = [""]

    def pump(process: subprocess.Popen, sink) -> None:
        for chunk in iter(lambda: process.stdout.read1(4096), b""):
            text = chunk.decode(errors="replace")
            sink.write(text)
            sink.flush()
            chunks.append(text)
            lines = [line for line in re.split(r"[\r\n]", text) if line.strip()]
            if lines:
                latest[0] = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", lines[-1]).strip()

    with log.open("w") as sink, subprocess.Popen(
        command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
    ) as process:
        reader = threading.Thread(target=pump, args=(process, sink), daemon=True)
        reader.start()
        while reader.is_alive():
            show_progress(time.monotonic() - began, label, latest[0])
            reader.join(timeout=1)
        process.wait()
    verdict = "ok" if process.returncode == 0 else f"exit {process.returncode}"
    if sys.stdout.isatty():
        print("\r\033[K", end="")
    print(f"[{time.monotonic() - began:6.0f}s] {label}: {verdict} (log: {log})", flush=True)
    return process.returncode, "".join(chunks)


def show_progress(seconds: float, label: str, latest: str) -> None:
    """Rewrite the terminal's last line with the running step's state."""
    if not sys.stdout.isatty():
        return
    line = f"[{seconds:6.0f}s] {label}  {latest}"
    width = shutil.get_terminal_size().columns - 1
    if len(line) > width:
        line = line[: max(width - 3, 0)] + "..."
    print(f"\r\033[K{line}", end="", flush=True)


def git(*arguments: str) -> None:
    subprocess.run(["git", *arguments], check=True)


def use_working_llvm() -> None:
    """Point the native build at an LLVM that exists, when the session's does not."""
    found = subprocess.run([str(ROOT / "scripts/llvm-prefix")], capture_output=True, text=True)
    if found.returncode == 0:
        os.environ["LLVM_SYS_231_PREFIX"] = found.stdout.strip()


class Summary:
    def __init__(self, path: Path) -> None:
        self.path = path

    def line(self, text: str) -> None:
        print(f"run-batches: {text}", flush=True)
        with self.path.open("a") as sink:
            sink.write(f"- {text}\n")

    def stop(self, number: int, why: str, args: argparse.Namespace) -> int:
        self.line(f"STOPPED at batch {number}: {why}")
        resume = f"scripts/run-batches --start {number}"
        if args.max_growth != 1.0:
            resume += f" --max-growth {args.max_growth}"
        self.line(f"after fixing it, resume with: {resume}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
