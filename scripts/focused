#!/usr/bin/env python3
"""Run the fragile-area fixtures through every corpus path, on both backends.

`tests/focused/list.txt` lists the fixtures and named tests. A `fixture` line
runs every `corpus_test` trial the harness generates for that file (restricted
by `MOJITO_CORPUS_FOCUS`, so the harness keeps owning trial names), then the
native differential its `conformance/pliron-parity.tsv` row allows: an
`exe-differential` fixture must print the same on the VM and natively, an
`error-differential` one must fail on both, and one with no row (or an
`ineligible` row) is checked on the VM alone. A `test` line runs one named
test of a root test target. The tier sits between `scripts/smoke` (under a
minute) and the overnight gate (about nine hours): it takes about four
minutes, within a ten-minute budget.

The script builds the test binaries and the CLI first, in one cargo call with
the `backend-pliron` feature unless `--vm-only`, so `target/debug/mojito`
keeps the feature set the native runs need. `--no-build` uses the newest
built executable of each test target instead. It exits 0 when everything
passes, 1 when anything fails, and 2 when the build fails. The report goes to
stdout and to `target/focused/last.log`.

Usage:
  scripts/focused                  # build, then run the whole list
  scripts/focused --vm-only        # skip the native backend (no LLVM needed)
  scripts/focused --filter span    # only entries whose path or test name contains `span`
  scripts/focused --no-build       # use the binaries already built
  scripts/focused --jobs 12        # entries run in parallel (default 8)
  scripts/focused --from-gate LOG  # print the list lines a gate log's failures add
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import sys
import time
import tomllib
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import tierlib  # noqa: E402
from tierlib import ROOT, first_difference, indent, mojito, native_env, tail  # noqa: E402

LIST = ROOT / "tests" / "focused" / "list.txt"
PARITY = ROOT / "conformance" / "pliron-parity.tsv"
LOG = ROOT / "target" / "focused" / "last.log"
CORPUS = "corpus_test"
KINDS = ("fixture", "test")
# `vm_ok` and `assets_ok` skip the fixtures that read stdin (corpus_test.rs
# `reads_stdin`), so listing one would check less than the line promises.
READS_STDIN = ("input.mojo", "pliron_input_echo.mojo")


@dataclass
class Entry:
    kind: str
    target: str
    name: str

    @property
    def label(self) -> str:
        return self.name if self.kind == "fixture" else f"{self.target}::{self.name}"


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--vm-only", action="store_true", help="skip the native backend")
    p.add_argument("--no-build", action="store_true", help="use the binaries already built")
    p.add_argument("--filter", metavar="TEXT",
                   help="only entries whose path or test name contains TEXT")
    p.add_argument("--jobs", type=int, default=8, help="entries run in parallel (default 8)")
    p.add_argument("--list", type=Path, default=LIST, help="the focused list")
    p.add_argument("--from-gate", type=Path, metavar="LOG",
                   help="print the list lines a nextest gate log's failures add, then exit")
    args = p.parse_args()

    entries = read_list(args.list)
    if args.from_gate:
        return from_gate(args.from_gate, entries, args.no_build, args.vm_only)
    if args.filter:
        entries = [e for e in entries if args.filter in e.label]
    env = test_env()
    began = time.monotonic()
    targets = sorted({CORPUS, *(e.target for e in entries if e.kind == "test")})
    executables = (built_executables(targets) if args.no_build
                   else build(targets, args.vm_only, env))
    if executables is None:
        return 2
    missing = [t for t in targets if t not in executables]
    if missing:
        print(f"focused: no built executable for {', '.join(missing)}")
        return 2
    parity = read_parity()

    def check(entry: Entry) -> str | None:
        if entry.kind == "fixture":
            return check_fixture(entry.name, executables[CORPUS], parity, args.vm_only, env)
        return check_test(executables[entry.target], entry.name, env)

    # Fixtures run longest, so they go first in submission order.
    entries.sort(key=lambda e: e.kind != "fixture")
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        results = list(pool.map(lambda e: (e, check(e)), entries))
    failures = [(e, problem) for e, problem in results if problem]
    lines = [f"FAIL {e.kind} {e.label}\n{indent(problem)}" for e, problem in failures]
    fixtures = sum(e.kind == "fixture" for e in entries)
    native = "VM only" if args.vm_only else "VM and native"
    lines.append(f"focused: {fixtures} fixtures ({native}), {len(entries) - fixtures} tests, "
                 f"{len(failures)} failed, {time.monotonic() - began:.0f}s")
    report = "\n".join(lines)
    print(report)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text(report + "\n")
    return 1 if failures else 0


def from_gate(log: Path, listed: list[Entry], no_build: bool, vm_only: bool) -> int:
    """Print a `fixture` or `test` line for each failure in `log` the list lacks.

    A corpus trial maps to its fixture through the harness itself: each file
    whose stem the trial names is listed under `MOJITO_CORPUS_FOCUS`, and the
    file is kept when its trials include a failing one.
    """
    failing: dict[str, set[str]] = {}
    for line in log.read_text(errors="replace").splitlines():
        words = line.split()
        if not words or words[0] not in ("FAIL", "TIMEOUT"):
            continue
        qualified = next((w for w in words if w.startswith("mojito::")), None)
        if qualified is None or words[-1] == qualified:
            continue
        failing.setdefault(qualified.removeprefix("mojito::"), set()).add(words[-1])
    env = test_env()
    executables = (built_executables([CORPUS]) if no_build
                   else build([CORPUS], vm_only, env))
    if not executables or CORPUS not in executables:
        return 2
    have = {(e.target, e.name) for e in listed}
    lines = []
    trials = failing.pop(CORPUS, set())
    stems = {trial.rsplit("::", 1)[-1] for trial in trials}
    for stem in sorted(stems):
        for candidate in sorted((ROOT / "assets").rglob(f"{stem}.mojo")):
            path = str(candidate.relative_to(ROOT))
            listing = tierlib.run([executables[CORPUS], "--list"], env,
                                  extra_env={"MOJITO_CORPUS_FOCUS": path})
            names = {row.removesuffix(": test") for row in listing.output.splitlines()}
            if names & trials and (CORPUS, path) not in have:
                lines.append(f"fixture {path}")
    for target in sorted(failing):
        lines += [f"test {target} {name}" for name in sorted(failing[target])
                  if (target, name) not in have]
    print("\n".join(lines))
    return 0


def test_env() -> dict[str, str]:
    """`native_env` plus the `[env]` table of `.cargo/config.toml`.

    Cargo sets that table only for the processes it launches, and the
    script runs the test executables itself, so their trial threads would
    otherwise get Rust's default stack.
    """
    env = native_env()
    config = tomllib.loads((ROOT / ".cargo" / "config.toml").read_text())
    for key, value in config.get("env", {}).items():
        env.setdefault(key, value if isinstance(value, str) else value["value"])
    return env


def read_list(path: Path) -> list[Entry]:
    entries = []
    for number, line in enumerate(path.read_text().splitlines(), 1):
        words = line.split("#", 1)[0].split()
        if not words:
            continue
        where = f"focused: {path}:{number}:"
        if words[0] == "fixture" and len(words) == 2:
            fixture = words[1]
            if not fixture.startswith("assets/"):
                sys.exit(f"{where} a fixture lives under assets/, not {fixture}")
            if not (ROOT / fixture).is_file():
                sys.exit(f"{where} no such fixture {fixture}")
            if Path(fixture).name in READS_STDIN:
                sys.exit(f"{where} {fixture} reads stdin, so the corpus groups skip it")
            entries.append(Entry("fixture", CORPUS, fixture))
        elif words[0] == "test" and len(words) == 3:
            if not (ROOT / "tests" / f"{words[1]}.rs").is_file() \
                    and not (ROOT / "tests" / words[1] / "main.rs").is_file():
                sys.exit(f"{where} no root test target {words[1]}")
            entries.append(Entry("test", words[1], words[2]))
        else:
            sys.exit(f"{where} expected `fixture <path>` or `test <target> <name>`")
    return entries


def read_parity() -> dict[str, str]:
    """Each fixture's native-parity status, by repository-relative path."""
    status = {}
    for line in PARITY.read_text().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        fields = line.split("\t")
        status[fields[0]] = fields[2]
    return status


def check_fixture(path: str, corpus: str, parity: dict[str, str], vm_only: bool,
                  env: dict[str, str]) -> str | None:
    """What is wrong with fixture `path`, or `None` when it passes."""
    problem = check_corpus(path, corpus, env)
    if problem or vm_only:
        return problem
    status = parity.get(path)
    if status not in ("exe-differential", "error-differential"):
        return None
    vm = mojito(["run", path], env)
    native = mojito(["run", "--backend", "pliron", path], env)
    if status == "error-differential":
        if vm.exit_code == 0:
            return f"the VM run succeeded, but its parity row expects a trap:\n{tail(vm.output)}"
        if native.exit_code == 0:
            return f"the native run succeeded, but the VM trapped:\n{tail(native.output)}"
        return None
    if vm.exit_code != 0:
        return f"the VM exited {vm.exit_code}:\n{tail(vm.output)}"
    if native.exit_code != 0:
        return f"the native run exited {native.exit_code}:\n{tail(native.output)}"
    if native.output != vm.output:
        return f"the native output differs from the VM's:\n{first_difference(vm.output, native.output)}"
    return None


def check_corpus(path: str, corpus: str, env: dict[str, str]) -> str | None:
    """Run every corpus trial for `path` in its own process, so a crash stays local."""
    done = tierlib.run([corpus, "--format", "json", "--test-threads", "2"], env,
                       extra_env={"MOJITO_CORPUS_FOCUS": path})
    started: set[str] = set()
    finished: set[str] = set()
    failed = []
    for line in done.output.splitlines():
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") != "test":
            continue
        name = event.get("name", "")
        if event.get("event") == "started":
            started.add(name)
            continue
        finished.add(name)
        if event.get("event") == "failed":
            failed.append(f"{name}: {trial_message(event.get('stdout', ''))}")
    if not started and done.exit_code == 0:
        return "no corpus trial covers it"
    if failed:
        return "\n".join(failed)
    if done.exit_code != 0:
        unfinished = sorted(started - finished)
        where = f" in {', '.join(unfinished)}" if unfinished else ""
        return f"the corpus run exited {done.exit_code}{where}:\n{tail(done.output)}"
    return None


def trial_message(stdout: str) -> str:
    """The first line of a failed trial's message, without libtest-mimic's wrapping."""
    message = stdout.strip().removeprefix('Error: "').removesuffix('"')
    return message.splitlines()[0] if message else "failed"


def check_test(executable: str, name: str, env: dict[str, str]) -> str | None:
    listed = tierlib.run([executable, "--list"], env)
    if f"{name}: test" not in listed.output.splitlines():
        return f"no test named `{name}` (renamed or removed?)"
    done = tierlib.run([executable, "--exact", name], env)
    if done.exit_code != 0:
        return f"the test exited {done.exit_code}:\n{tail(done.output, 20)}"
    return None


def build(targets: list[str], vm_only: bool, env: dict[str, str]) -> dict[str, str] | None:
    """Build the test targets (and with them the CLI), returning each one's executable."""
    features = [] if vm_only else ["--features", "backend-pliron"]
    if not vm_only and not tierlib.build(
            [["cargo", "build", "--quiet", "-p", "mojito-runtime"]], env, "focused"):
        return None
    command = ["cargo", "test", "--no-run", "--quiet", "--message-format=json", *features]
    for target in targets:
        command += ["--test", target]
    done = tierlib.run(command, env)
    if done.exit_code != 0:
        print(f"focused: `{' '.join(command)}` failed:\n{tail(done.output, 40)}")
        return None
    executables = {}
    for line in done.output.splitlines():
        if not line.startswith("{"):
            continue
        message = json.loads(line)
        target = message.get("target", {})
        if (message.get("reason") == "compiler-artifact" and target.get("kind") == ["test"]
                and message.get("profile", {}).get("test") and message.get("executable")):
            executables[target["name"]] = message["executable"]
    return executables


def built_executables(targets: list[str]) -> dict[str, str]:
    """The newest built executable of each test target, for `--no-build`."""
    deps = ROOT / "target" / "debug" / "deps"
    executables = {}
    for target in targets:
        candidates = [p for p in deps.glob(f"{target}-*")
                      if p.suffix == "" and p.is_file() and p.stat().st_mode & 0o111]
        if candidates:
            executables[target] = str(max(candidates, key=lambda p: p.stat().st_mtime))
    return executables


if __name__ == "__main__":
    sys.exit(main())
