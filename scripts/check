#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "==> parity manifest"
scripts/check-parity-manifest

echo "==> cargo fmt --check"
cargo fmt --check

echo "==> cargo nextest run"
# nextest does not run doctests; this crate has none. If doctests are
# ever added, run them separately here (cargo test --doc).
cargo nextest run

echo "==> cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings
