#!/usr/bin/env bash
# The default (VM-lane) gate. Every step runs even when an earlier one fails,
# for the reason --no-fail-fast is passed to nextest below: one failure must
# not hide the rest of the report. A failing suite used to abort the script
# before clippy, so lints in test code stayed invisible for as long as any
# test was red (gate run 2026-09-18).
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

status=0

run_step() {
    local name="$1"
    shift
    echo "==> ${name}"
    "$@" || status=1
}

run_step "parity manifest" scripts/check-parity-manifest

run_step "cargo fmt --all --check" cargo fmt --all --check

# nextest does not run doctests; this workspace has none. If doctests are
# ever added, run them separately here (cargo test --doc).
# --exclude mojito-pliron: that member is the LLVM lane; this default gate
# must never require LLVM (scripts/check-pliron covers it).
run_step "cargo nextest run --workspace (minus the LLVM-lane crate)" \
    cargo nextest run --workspace --exclude mojito-pliron --no-fail-fast

run_step "cargo clippy --workspace --all-targets -- -D warnings" \
    cargo clippy --workspace --exclude mojito-pliron --all-targets -- -D warnings

exit "${status}"
