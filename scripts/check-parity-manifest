#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$root/conformance/parity.tsv"
cases="$root/conformance/cases.tsv"
manual_sections="$root/conformance/manual-sections.tsv"
assets_rejects="$root/conformance/assets-mojo-rejects.tsv"
assets_diffs="$root/conformance/assets-mojo-output-diffs.tsv"
assets_errors="$root/conformance/assets-mojo-errors.tsv"

awk -F '\t' '
BEGIN { ok = 1; rows = 0 }
/^#/ || NF == 0 { next }
$1 == "id" {
    if ($0 != "id\tarea\tstatus\tscope\trelation\tmojo_behavior\tmojito_behavior\tevidence\tnotes") {
        print "invalid parity manifest header" > "/dev/stderr"; ok = 0
    }
    next
}
{
    rows++
    if (NF != 9) { print "parity row " NR " has " NF " fields, expected 9" > "/dev/stderr"; ok = 0 }
    if (seen[$1]++) { print "duplicate parity id: " $1 > "/dev/stderr"; ok = 0 }
    if ($3 !~ /^(implemented|partial|excluded|stretch)$/) { print "invalid status for " $1 ": " $3 > "/dev/stderr"; ok = 0 }
    if ($4 !~ /^(first-pass|excluded|post-native)$/) { print "invalid scope for " $1 ": " $4 > "/dev/stderr"; ok = 0 }
    if ($5 !~ /^(match|subset|divergence|representation|excluded|stretch)$/) { print "invalid relation for " $1 ": " $5 > "/dev/stderr"; ok = 0 }
    if ($6 == "" || $7 == "" || $8 == "") { print "missing behavior or evidence for " $1 > "/dev/stderr"; ok = 0 }
    if ($5 == "divergence" && $8 !~ /(^|;)case:/) { print "divergence lacks differential case: " $1 > "/dev/stderr"; ok = 0 }
    if ($3 == "implemented" && $5 !~ /^(match|representation)$/) { print "implemented row has non-parity relation: " $1 > "/dev/stderr"; ok = 0 }
    if ($3 == "implemented" && $4 == "first-pass" && $5 == "match" && $8 !~ /(^|;)case:/) {
        print "implemented first-pass match lacks differential case: " $1 > "/dev/stderr"; ok = 0
    }
    if ($3 == "excluded" && ($4 != "excluded" || $5 != "excluded")) { print "inconsistent excluded row: " $1 > "/dev/stderr"; ok = 0 }
    if ($3 == "stretch" && $5 != "stretch") { print "inconsistent stretch row: " $1 > "/dev/stderr"; ok = 0 }
}
END {
    if (rows == 0) { print "parity manifest has no rows" > "/dev/stderr"; ok = 0 }
    exit(ok ? 0 : 1)
}
' "$manifest"

case_ids="$(awk -F '\t' '!/^#/ && $1 != "id" && NF { print $1 }' "$cases")"
manual_ids="$(awk -F '\t' '!/^#/ && $1 != "id" && NF { print $1 }' "$manual_sections")"

while IFS=$'\t' read -r id _area _status _scope _relation _mojo _mojito evidence _notes; do
    [[ -z "$id" || "$id" == \#* || "$id" == "id" ]] && continue
    IFS=';' read -ra refs <<<"$evidence"
    for ref in "${refs[@]}"; do
        case "$ref" in
            case:*)
                case_id="${ref#case:}"
                if ! grep -Fxq "$case_id" <<<"$case_ids"; then
                    echo "parity row $id references missing case: $case_id" >&2
                    exit 1
                fi
                ;;
            test:*|docs:*)
                path="${ref#*:}"
                path="${path%%::*}"
                path="${path%%#*}"
                if [[ ! -e "$root/$path" ]]; then
                    echo "parity row $id references missing file: $path" >&2
                    exit 1
                fi
                ;;
            manual:*)
                manual_id="${ref#manual:}"
                if ! grep -Fxq "$manual_id" <<<"$manual_ids"; then
                    echo "parity row $id references missing manual section: $manual_id" >&2
                    exit 1
                fi
                ;;
            *)
                echo "parity row $id has invalid evidence reference: $ref" >&2
                exit 1
                ;;
        esac
    done
done <"$manifest"

while IFS=$'\t' read -r manual_id scope url; do
    [[ -z "$manual_id" || "$manual_id" == \#* || "$manual_id" == "id" ]] && continue
    if [[ "$scope" != "first-pass" && "$scope" != "excluded" ]]; then
        echo "manual section $manual_id has invalid scope: $scope" >&2
        exit 1
    fi
    if [[ "$url" != https://mojolang.org/* ]]; then
        echo "manual section $manual_id has non-official URL: $url" >&2
        exit 1
    fi
    if ! grep -Fq "manual:$manual_id" "$manifest"; then
        echo "manual section is not covered by parity manifest: $manual_id" >&2
        exit 1
    fi
done <"$manual_sections"

awk -F '\t' '
BEGIN { ok = 1; rows = 0 }
/^#/ || NF == 0 { next }
$1 == "id" { if ($0 != "id\tmode\tfixture") { print "invalid conformance case header" > "/dev/stderr"; ok = 0 }; next }
{
    rows++
    if (NF != 3) { print "conformance case row " NR " has " NF " fields, expected 3" > "/dev/stderr"; ok = 0 }
    if (seen[$1]++) { print "duplicate conformance case id: " $1 > "/dev/stderr"; ok = 0 }
    if ($2 !~ /^(run|reject|mojo-only|mojito-only|output-diff)$/) { print "invalid conformance mode for " $1 ": " $2 > "/dev/stderr"; ok = 0 }
}
END { if (rows == 0) ok = 0; exit(ok ? 0 : 1) }
' "$cases"

while IFS=$'\t' read -r id _mode fixture; do
    [[ -z "$id" || "$id" == \#* || "$id" == "id" ]] && continue
    if [[ ! -f "$root/$fixture" ]]; then
        echo "conformance case $id references missing fixture: $fixture" >&2
        exit 1
    fi
done <"$cases"

# The two assets-sweep manifests (scripts/sweep-assets-mojo). Only their schema
# is checked here; running the pinned Mojo is that script's job.
awk -F '\t' '
BEGIN { ok = 1 }
/^# swept-count\t/ { if ($2 !~ /^[0-9]+$/) { print "invalid swept-count: " $2 > "/dev/stderr"; ok = 0 }; swept = 1; next }
/^#/ || NF == 0 { next }
$1 == "fixture" { if ($0 != "fixture\tfamily\tfirst-error") { print "invalid assets reject header" > "/dev/stderr"; ok = 0 }; next }
{
    if (NF != 3) { print "assets reject row " NR " has " NF " fields, expected 3" > "/dev/stderr"; ok = 0 }
    if (seen[$1]++) { print "duplicate assets reject fixture: " $1 > "/dev/stderr"; ok = 0 }
    if ($2 !~ /^(alias-keyword|self-qualification|unbound-parameter|missing-import|no-main|iterator-protocol|hasher-protocol|layout-alignment|ledgered|divergence|skip)$/) {
        print "invalid assets reject family for " $1 ": " $2 > "/dev/stderr"; ok = 0
    }
    if ($3 == "") { print "assets reject row lacks an error: " $1 > "/dev/stderr"; ok = 0 }
}
END { if (!swept) { print "assets reject manifest lacks a # swept-count header" > "/dev/stderr"; ok = 0 }; exit(ok ? 0 : 1) }
' "$assets_rejects"

awk -F '\t' '
BEGIN { ok = 1 }
/^#/ || NF == 0 { next }
$1 == "fixture" { if ($0 != "fixture\tfamily\tdivergence") { print "invalid assets output-diff header" > "/dev/stderr"; ok = 0 }; next }
{
    if (NF != 3) { print "assets output-diff row " NR " has " NF " fields, expected 3" > "/dev/stderr"; ok = 0 }
    if (seen[$1]++) { print "duplicate assets output-diff fixture: " $1 > "/dev/stderr"; ok = 0 }
    if ($2 !~ /^(float-format|arithmetic|drop-timing|one-off)$/) { print "invalid assets output-diff family for " $1 ": " $2 > "/dev/stderr"; ok = 0 }
    if ($3 == "") { print "assets output-diff row lacks a description: " $1 > "/dev/stderr"; ok = 0 }
}
' "$assets_diffs"

# The error-folder verdict ledger (scripts/sweep-assets-mojo --errors). Agreement
# is the verdict matching what the fixture's folder claims, so the folder and the
# family constrain each other.
awk -F '\t' '
BEGIN { ok = 1 }
/^# swept-count\t/ { if ($2 !~ /^[0-9]+$/) { print "invalid error-ledger swept-count: " $2 > "/dev/stderr"; ok = 0 }; swept = 1; next }
/^#/ || NF == 0 { next }
$1 == "fixture" { if ($0 != "fixture\tverdict\tfamily\tupstream") { print "invalid error-ledger header" > "/dev/stderr"; ok = 0 }; next }
{
    if (NF != 4) { print "error-ledger row " NR " has " NF " fields, expected 4" > "/dev/stderr"; ok = 0 }
    if (seen[$1]++) { print "duplicate error-ledger fixture: " $1 > "/dev/stderr"; ok = 0 }
    if ($1 !~ /^assets\/(parse_error|type_error|runtime_error|ownership_error|origin_error)\//) {
        print "error-ledger fixture is not in an error folder: " $1 > "/dev/stderr"; ok = 0
    }
    if ($2 !~ /^(compile-reject|trap|runs|timeout)$/) { print "invalid error-ledger verdict for " $1 ": " $2 > "/dev/stderr"; ok = 0 }
    if ($3 !~ /^(agree|alias-keyword|self-qualification|unbound-parameter|missing-import|no-main|iterator-protocol|ledgered|subset|divergence|skip)$/) {
        print "invalid error-ledger family for " $1 ": " $3 > "/dev/stderr"; ok = 0
    }
    if ($4 == "") { print "error-ledger row lacks upstream text: " $1 > "/dev/stderr"; ok = 0 }

    # An agreeing row must carry the verdict its folder claims.
    want = ($1 ~ /^assets\/runtime_error\//) ? "trap" : "compile-reject"
    if ($3 == "agree" && $2 != want) {
        print "error-ledger row claims agreement with the wrong verdict: " $1 " (" $2 ", expected " want ")" > "/dev/stderr"; ok = 0
    }
    # The pin accepting a program Mojito rejects is never agreement, and a
    # burn-down family only describes a rejection.
    if ($2 == "runs" && $3 !~ /^(subset|divergence|skip)$/) {
        print "error-ledger row the pin runs needs a subset/divergence family: " $1 " (" $3 ")" > "/dev/stderr"; ok = 0
    }
    if ($3 ~ /^(alias-keyword|self-qualification|unbound-parameter|missing-import|no-main|iterator-protocol|ledgered)$/ && $2 != "compile-reject") {
        print "error-ledger masking family needs a compile-reject verdict: " $1 > "/dev/stderr"; ok = 0
    }
    # An import that does not resolve, or a missing `main`, is never the defect an
    # error fixture set out to pin: the pin stopped before reaching it.
    if ($3 == "agree" && $4 ~ /unable to locate module|global variables are not supported|module does not define a/) {
        print "error-ledger row claims agreement on a masking complaint: " $1 > "/dev/stderr"; ok = 0
    }
}
END { if (!swept) { print "error ledger lacks a # swept-count header" > "/dev/stderr"; ok = 0 }; exit(ok ? 0 : 1) }
' "$assets_errors"

# A fixture the pinned Mojo rejects cannot also be claimed as a matching run.
run_fixtures="$(awk -F '\t' '!/^#/ && $2 == "run" { print $3 }' "$cases")"
while IFS=$'\t' read -r fixture _family _error; do
    [[ -z "$fixture" || "$fixture" == \#* || "$fixture" == "fixture" ]] && continue
    if [[ ! -f "$root/$fixture" ]]; then
        echo "assets reject manifest references missing fixture: $fixture" >&2
        exit 1
    fi
    if grep -Fxq "$fixture" <<<"$run_fixtures"; then
        echo "fixture is both a cases.tsv run row and a known reject: $fixture" >&2
        exit 1
    fi
done <"$assets_rejects"

while IFS=$'\t' read -r fixture _family _divergence; do
    [[ -z "$fixture" || "$fixture" == \#* || "$fixture" == "fixture" ]] && continue
    if [[ ! -f "$root/$fixture" ]]; then
        echo "assets output-diff manifest references missing fixture: $fixture" >&2
        exit 1
    fi
    if grep -Fxq "$fixture" <<<"$run_fixtures"; then
        echo "fixture is both a cases.tsv run row and a known output divergence: $fixture" >&2
        exit 1
    fi
done <"$assets_diffs"

while IFS=$'\t' read -r fixture _verdict _family _upstream; do
    [[ -z "$fixture" || "$fixture" == \#* || "$fixture" == "fixture" ]] && continue
    if [[ ! -f "$root/$fixture" ]]; then
        echo "error ledger references missing fixture: $fixture" >&2
        exit 1
    fi
    if grep -Fxq "$fixture" <<<"$run_fixtures"; then
        echo "fixture is both a cases.tsv run row and an error-folder fixture: $fixture" >&2
        exit 1
    fi
done <"$assets_errors"

# Every error-folder fixture on disk needs a ledger row; the sweep is the oracle
# for the verdict, this is the oracle for the file being complete.
missing="$(comm -23 \
    <(find "$root/assets/parse_error" "$root/assets/type_error" "$root/assets/runtime_error" \
        "$root/assets/ownership_error" "$root/assets/origin_error" -name '*.mojo' \
        | sed "s|^$root/||" | sort) \
    <(awk -F '\t' '!/^#/ && NF && $1 != "fixture" { print $1 }' "$assets_errors" | sort))"
if [[ -n "$missing" ]]; then
    echo "error-folder fixtures with no ledger row:" >&2
    sed 's/^/  /' <<<"$missing" >&2
    exit 1
fi

# The two generated Pliron manifests. Their own sweeps (tests/heavy/) are the
# oracle for every row's status, but those cost 30-60 minutes and sit outside
# the overnight gate, so a hand-added row's mistakes stayed invisible for days
# (gate run 2026-09-18: two rows inserted out of order, and a coverage ratchet
# under-bumped at 02d2cc9 and carried for four days). These three checks are
# static, cost milliseconds, and catch exactly that class.
heavy="$root/tests/heavy/main.rs"
pliron_rows() { awk -F '\t' '!/^#/ && NF >= 3 { print $1 "\t" $3 }' "$1"; }

# 1. `support::fixture_sources` sorts each directory's file names, so the rows
#    of one directory must be in byte order. An insertion in the wrong slot
#    fails the sweep's generated-file assertion and nothing else.
LC_ALL=C awk -F '\t' '
    { split($1, parts, "/"); base = parts[length(parts)]
      dir = substr($1, 1, length($1) - length(base))
      if (dir == prev_dir && base < prev_base) {
          print FILENAME ": row out of order: " $1 " must precede " dir prev_base > "/dev/stderr"; bad = 1
      }
      prev_dir = dir; prev_base = base }
    END { exit(bad ? 1 : 0) }
' <(pliron_rows "$root/conformance/pliron-parity.tsv") \
  <(pliron_rows "$root/conformance/pliron-scalar.tsv") || exit 1

# 2. Each sweep concatenates its directories in a fixed order and never sorts
#    the whole list, so every directory owns one contiguous block and the
#    blocks follow that order. Check 1 compares only rows of the same
#    directory, so re-sorting a whole manifest passes it and fails nothing
#    until the sweep runs: 337a7ab lifted the assets/extensions blocks of both
#    manifests to the top and stayed invisible until the 2026-09-24 gate.
check_blocks() {
    local manifest="$1"
    shift
    LC_ALL=C awk -F '\t' -v expected="$*" -v name="${manifest#"$root/"}" '
        BEGIN { count = split(expected, order, " ") }
        { dir = $1; sub(/\/[^\/]*$/, "/", dir)
          if (dir == current) next
          for (i = placed + 1; i <= count; i++) {
              if (order[i] == dir) { placed = i; current = dir; next }
          }
          current = dir
          print name ": " dir " rows do not follow the sweep order at " $1 \
              " (expected " expected ")" > "/dev/stderr"; bad = 1 }
        END { exit(bad ? 1 : 0) }
    ' <(pliron_rows "$manifest") || exit 1
}
check_blocks "$root/conformance/pliron-parity.tsv" \
    assets/ok/ assets/ownership_ok/ assets/extensions/ok/ \
    assets/extensions/ownership_ok/ assets/runtime_error/
check_blocks "$root/conformance/pliron-scalar.tsv" \
    assets/ok/ assets/extensions/ok/ assets/runtime_error/

# 3. Each manifest names every fixture of the folders its sweep walks, once.
check_inventory() {
    local manifest="$1"
    shift
    local missing
    missing="$(comm -3 \
        <(find "$@" -name '*.mojo' | sed "s|^$root/||" | LC_ALL=C sort) \
        <(pliron_rows "$manifest" | cut -f1 | LC_ALL=C sort))"
    if [[ -n "$missing" ]]; then
        echo "${manifest#"$root/"}: rows and fixture inventory disagree" >&2
        echo "  (left column: no row; right column: no fixture)" >&2
        sed 's/^/  /' <<<"$missing" >&2
        exit 1
    fi
}
check_inventory "$root/conformance/pliron-parity.tsv" \
    "$root/assets/ok" "$root/assets/ownership_ok" "$root/assets/extensions/ok" \
    "$root/assets/extensions/ownership_ok" "$root/assets/runtime_error"
check_inventory "$root/conformance/pliron-scalar.tsv" \
    "$root/assets/ok" "$root/assets/extensions/ok" "$root/assets/runtime_error"

# 4. The parity sweep's coverage ratchets are equalities against the same rows,
#    so they are arithmetic on the checked-in manifest. Bumping one without the
#    other is the drift that hid here for four days.
for pair in "exe-differential:differential" "error-differential:errors"; do
    status="${pair%%:*}"
    ratchet_name="${pair##*:}"
    rows="$(pliron_rows "$root/conformance/pliron-parity.tsv" | awk -F '\t' -v s="$status" '$2 == s' | wc -l)"
    ratchet="$(grep -oE "${ratchet_name} == [0-9]+" "$heavy" | head -1 | grep -oE '[0-9]+')"
    if [[ "$rows" != "$ratchet" ]]; then
        echo "tests/heavy/main.rs: '${ratchet_name} == ${ratchet}' but pliron-parity.tsv has ${rows} ${status} rows" >&2
        exit 1
    fi
done

echo "parity manifest: ok"
