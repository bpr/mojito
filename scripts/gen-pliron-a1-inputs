#!/usr/bin/env python3
"""Freeze the A1 measurement inputs.

    scripts/gen-pliron-a1-inputs [--out target/pliron-a1]

Writes the two gate stress inputs and the two frozen, sorted input lists
(`focused-inputs.tsv`, `corpus-inputs.tsv`): path, sha256, category. The
stress inputs repeat the gate's `Part`/`Proof`/`risky`/`exercise` under
distinct names and call each copy; nothing is looped at run time.

The decision corpus is the union of the round-trip categories of
tests/corpus_test.rs (`ok`, `origin_ok`, `ownership_ok`, and their extension
folders), the parity and scalar manifest rows that are not `ineligible`
(which bring the `runtime_error` fixtures: they compile), and the focused
set, deduplicated by path.
"""

import argparse
import hashlib
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GATE = "assets/extensions/ok/pliron_a1_gate.mojo"
BENCHMARKS = ("empty", "hello", "add", "generic", "tuple", "tstring", "stdlib_heavy")
RENAMED = ("Part", "Proof", "risky", "exercise")


def stress(copies):
    source = (ROOT / GATE).read_text()
    body, main = source.split("def main():")
    assert "exercise(False, 1)" in main and "exercise(True, 2)" in main
    out = []
    for copy in range(copies):
        renamed = body
        for name in RENAMED:
            renamed = re.sub(rf"\b{name}\b", f"{name}{copy}", renamed)
        out.append(renamed.rstrip() + "\n")
    calls = "".join(
        f"    exercise{copy}(False, 1)\n    exercise{copy}(True, 2)\n"
        for copy in range(copies))
    return "\n\n".join(out) + "\n\ndef main():\n" + calls


def row(path, category):
    digest = hashlib.sha256((ROOT / path).read_bytes()).hexdigest()
    return f"{path}\t{digest}\t{category}\n"


def manifest_rows(name):
    rows = []
    for line in (ROOT / "conformance" / name).read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split("\t")
        if fields[2] != "ineligible":
            rows.append(fields[0])
    return rows


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--out", default="target/pliron-a1")
    out = Path(parser.parse_args().out)
    (ROOT / out / "stress").mkdir(parents=True, exist_ok=True)

    focused = {GATE: "gate"}
    for name in BENCHMARKS:
        focused[f"benchmarks/compile/{name}.mojo"] = "benchmark"
    for copies in (16, 64):
        path = out / "stress" / f"gate_x{copies}.mojo"
        (ROOT / path).write_text(stress(copies))
        focused[str(path)] = "stress"

    corpus = {}
    for category in ("ok", "origin_ok", "ownership_ok"):
        for folder in (f"assets/{category}", f"assets/extensions/{category}"):
            for path in sorted((ROOT / folder).glob("*.mojo")):
                corpus[str(path.relative_to(ROOT))] = category
    for name in ("pliron-parity.tsv", "pliron-scalar.tsv"):
        for path in manifest_rows(name):
            corpus.setdefault(path, "manifest")
    corpus.update(focused)

    header = "path\tsha256\tcategory\n"
    for name, inputs in (("focused-inputs.tsv", focused), ("corpus-inputs.tsv", corpus)):
        rows = "".join(row(path, inputs[path]) for path in sorted(inputs))
        (ROOT / out / name).write_text(header + rows)
        print(f"{out / name}: {len(inputs)} inputs")


if __name__ == "__main__":
    main()
