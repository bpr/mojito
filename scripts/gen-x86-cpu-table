#!/usr/bin/env python3
"""Generate `crates/mojito-native-core/src/target/x86_cpus.rs` from the pin.

Usage: scripts/gen-x86-cpu-table [--mojo MOJO] [--llc LLC] [--out FILE]

MOJO is the pinned `mojo` binary (`docs/mojo-nightly.md`); it defaults to the
pinned pixi environment. LLC is the pinned toolchain's `llc` (LLVM 23.1); it
defaults to `$LLVM_SYS_231_PREFIX/bin/llc`, then `/opt/llvm-23/bin/llc`.

The script reads the pin's x86-64 CPU names (`mojo build
--print-supported-cpus`) and, for each one, the feature list the pin resolves
for it (`mojo build --target-cpu CPU --print-effective-target`), and writes
them as one Rust table the native target answers `--target-cpu` and
`--target-features` from. It also writes LLVM's x86 feature names, against
which the driver warns about an unrecognized `--target-features` name as the
pin does.

The script refuses to write when a pin CPU is unknown to `llc -mcpu=help`, a
pin feature is unknown to `llc -mattr=help`, or a pin feature list is not a
sorted list of `+name` items (the merge rule depends on both). It formats
its output with `rustfmt`. Re-run it at every re-pin and review the diff
like any other generated table.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_MOJO = os.path.expanduser(
    "~/src/mojo/envs/mojo-2026101705/.pixi/envs/default/bin/mojo"
)
DEFAULT_OUT = os.path.join(
    ROOT, "crates", "mojito-native-core", "src", "target", "x86_cpus.rs"
)
TRIPLE = "x86_64-unknown-linux-gnu"


def run(cmd: list[str]) -> str:
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(f"error: {' '.join(cmd)} failed:\n{result.stderr}")
    return result.stdout + result.stderr


def pin_cpus(mojo: str, scratch: str) -> list[str]:
    out = run([mojo, "build", "--print-supported-cpus", "--target-triple", TRIPLE, scratch])
    lines = out.splitlines()
    start = next(i for i, line in enumerate(lines) if line.startswith("Available CPUs"))
    return [line.strip() for line in lines[start + 1 :] if line.strip()]


def pin_features(mojo: str, scratch: str, cpu: str) -> list[str]:
    out = run(
        [
            mojo,
            "build",
            "--target-triple",
            TRIPLE,
            "--target-cpu",
            cpu,
            "--print-effective-target",
            scratch,
        ]
    )
    match = re.search(r"--target-features (\S*)", out)
    if match is None:
        sys.exit(f"error: no --target-features line for CPU '{cpu}':\n{out}")
    items = [item for item in match.group(1).split(",") if item]
    if any(not item.startswith("+") for item in items):
        sys.exit(f"error: CPU '{cpu}' lists a feature that is not '+name': {items}")
    names = [item[1:] for item in items]
    if names != sorted(names):
        sys.exit(f"error: CPU '{cpu}' features are not sorted: {names}")
    return names


def llc_names(llc: str, section: str) -> set[str]:
    out = run([llc, f"-mtriple={TRIPLE}", "-mattr=help"])
    lines = out.splitlines()
    start = next(i for i, line in enumerate(lines) if line.startswith(f"Available {section}"))
    names: set[str] = set()
    for line in lines[start + 1 :]:
        if line.startswith("Available ") or line.startswith("Use +feature"):
            break
        if line.strip():
            names.add(line.split()[0])
    return names


def llvm_version(llc: str) -> str:
    match = re.search(r"LLVM version (\S+)", run([llc, "--version"]))
    return match.group(1) if match else "unknown"


def render(pin: str, llvm: str, cpus: dict[str, list[str]], features: list[str]) -> str:
    out = [
        "// @generated by scripts/gen-x86-cpu-table from "
        f"{pin} and LLVM {llvm}.",
        "// Do not edit; regenerate at every re-pin.",
        "",
        "//! The pin's x86-64 CPU table: every `--target-cpu` name the pin accepts,",
        "//! each with the feature list the pin resolves for it, plus LLVM's x86",
        "//! feature names.",
        "",
        "/// One pin CPU: its LLVM name and its table features, without `+`, sorted.",
        "#[derive(Debug, PartialEq, Eq)]",
        "pub(super) struct CpuModel {",
        "    pub name: &'static str,",
        "    pub features: &'static [&'static str],",
        "}",
        "",
        "/// The `x86-64` row, the default target CPU.",
        "pub(super) const X86_64: &CpuModel = &CpuModel {",
        '    name: "x86-64",',
        f"    features: &[{', '.join(repr_str(f) for f in cpus['x86-64'])}],",
        "};",
        "",
        "/// Every pin CPU, sorted by name.",
        "pub(super) const X86_CPUS: &[CpuModel] = &[",
    ]
    for name in sorted(cpus):
        out.append("    CpuModel {")
        out.append(f"        name: {repr_str(name)},")
        out.append("        features: &[")
        out.extend(f"            {repr_str(f)}," for f in cpus[name])
        out.append("        ],")
        out.append("    },")
    out.append("];")
    out.append("")
    out.append("/// LLVM's x86 feature names, sorted.")
    out.append("pub(super) const LLVM_X86_FEATURES: &[&str] = &[")
    out.extend(f"    {repr_str(f)}," for f in sorted(features))
    out.append("];")
    return "\n".join(out) + "\n"


def repr_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--mojo", default=DEFAULT_MOJO)
    prefix = os.environ.get("LLVM_SYS_231_PREFIX", "/opt/llvm-23")
    parser.add_argument("--llc", default=os.path.join(prefix, "bin", "llc"))
    parser.add_argument("--out", default=DEFAULT_OUT)
    args = parser.parse_args()

    pin = run([args.mojo, "--version"]).strip()
    llvm = llvm_version(args.llc)
    llvm_cpus = llc_names(args.llc, "CPUs")
    llvm_features = llc_names(args.llc, "features")

    with tempfile.TemporaryDirectory() as scratch_dir:
        scratch = os.path.join(scratch_dir, "hello.mojo")
        with open(scratch, "w") as handle:
            handle.write('def main():\n    print("hi")\n')
        names = pin_cpus(args.mojo, scratch)
        cpus = {name: pin_features(args.mojo, scratch, name) for name in names}

    errors = [f"pin CPU '{name}' is unknown to LLVM {llvm}" for name in names if name not in llvm_cpus]
    errors += [
        f"pin CPU '{name}' feature '{feature}' is unknown to LLVM {llvm}"
        for name, features in cpus.items()
        for feature in features
        if feature not in llvm_features
    ]
    if "x86-64" not in cpus:
        errors.append("the pin lists no 'x86-64' CPU")
    if errors:
        sys.exit("error: refusing to write:\n  " + "\n  ".join(errors))

    with open(args.out, "w") as handle:
        handle.write(render(pin, llvm, cpus, sorted(llvm_features)))
    # Format as `cargo fmt` would, so a regeneration diffs only in data.
    run(["rustfmt", "--edition", "2024", "--config-path", ROOT, args.out])
    print(f"wrote {args.out}: {len(cpus)} CPUs, {len(llvm_features)} LLVM features")


if __name__ == "__main__":
    main()
